# ============================================================
# Customer Churn MLOps .env
# Đặt file này cùng cấp với docker-compose.yaml
# ============================================================

# ---------------- Project paths ----------------
CUSTOMER_CHURN_PROJECT_DIR=/opt/airflow/project
CUSTOMER_CHURN_RAW_DATA_PATH=/opt/airflow/project/data/raw/ecommerce_customer_churn_dataset.csv
PARAMS_PATH=params_staged_pipeline.yaml
PYTHONUNBUFFERED=1
PYTHONPATH=/opt/airflow/project
DVC_NO_ANALYTICS=1

# ---------------- Airflow user ----------------
AIRFLOW_UID=50000
AIRFLOW_GID=0
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow123
_AIRFLOW_WWW_USER_EMAIL=admin@airflow.local

# ---------------- Airflow core ----------------
AIRFLOW__CORE__EXECUTOR=CeleryExecutor
AIRFLOW__CORE__LOAD_EXAMPLES=false
AIRFLOW__CORE__DAGS_ARE_PAUSED_AT_CREATION=true
AIRFLOW__CORE__FERNET_KEY=4fAMyXo5MD0b6TgOOfaYo56A4_PVqgQd7dpAsg3GdZs=
AIRFLOW__WEBSERVER__SECRET_KEY=local-dev-airflow-secret-key-change-me
AIRFLOW__CORE__DAGBAG_IMPORT_TIMEOUT=120
AIRFLOW__CORE__DAG_FILE_PROCESSOR_TIMEOUT=180

# ---------------- Airflow DB / Celery ----------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflowpass
AIRFLOW_DB_NAME=airflow
AIRFLOW__CELERY__WORKER_CONCURRENCY=2
AIRFLOW__CELERY__WORKER_PREFETCH_MULTIPLIER=1
AIRFLOW__SCHEDULER__TASK_QUEUED_TIMEOUT=1800
AIRFLOW__SCHEDULER__TASK_QUEUED_TIMEOUT_CHECK_INTERVAL=60

# ---------------- Airflow logging ----------------
AIRFLOW__LOGGING__REMOTE_LOGGING=true
AIRFLOW__LOGGING__REMOTE_LOG_CONN_ID=minio_conn
AIRFLOW__LOGGING__REMOTE_BASE_LOG_FOLDER=s3://airflow-logs
AIRFLOW__LOGGING__DELETE_LOCAL_LOGS=true
AIRFLOW_LOCAL_LOG_RETENTION_DAYS=3

# ---------------- Service ports ----------------
AIRFLOW_WEBSERVER_PORT=8080
MLFLOW_PORT=5000
POSTGRES_PORT=5432
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ---------------- MinIO / S3 ----------------
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_DEFAULT_REGION=us-east-1
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
AIRFLOW_LOG_BUCKET=airflow-logs
MLFLOW_ARTIFACT_BUCKET=mlflow-artifacts
DVC_REMOTE_BUCKET=dvc-remote

# ---------------- MLflow ----------------
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=mlflowpass
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_EXPERIMENT_NAME=Churned_Staged_Preprocess_FS_Grid
MLFLOW_REGISTRY_NAME=churn_model_staged_best

# ---------------- GridSearch / training override ----------------
THREAD_POOL_MAX_WORKERS=2
GRID_SEARCH_METHOD=early_stop
GRID_SEARCH_SCORING=f1
GRID_SEARCH_CV_FOLDS=5
GRID_SEARCH_INNER_N_JOBS=1
GRID_SEARCH_VERBOSE=0
GRID_SEARCH_TRY_SMOTE=true
GRID_SEARCH_MAX_EVALUATED_CANDIDATES=20
GRID_SEARCH_MIN_EVALUATED_CANDIDATES=20
GRID_SEARCH_EARLY_STOP_PATIENCE=10
GRID_SEARCH_EARLY_STOP_MIN_DELTA=0.0001
GRID_SEARCH_PARAM_SHUFFLE=true
GRID_SEARCH_RANDOM_STATE=42

# ---------------- Threshold / model selection override ----------------
THRESHOLD_VALUES=0.5,0.35
MODEL_SELECTION_THRESHOLD=0.35
MODEL_SELECTION_METRIC=test_f1_churned_threshold
